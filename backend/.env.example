# Copy to backend/.env for local development. Never commit credentials.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
# For asymmetric signing, configure SUPABASE_URL and optionally comma-separated algorithms:
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# For projects using legacy HS256 signing only, set both values securely:
# SUPABASE_JWT_SECRET=<legacy-jwt-secret>
# SUPABASE_JWT_ALGORITHM=HS256
EDAS_EVIDENCE_BUCKET=road-evidence
EDAS_EVIDENCE_MAX_SIZE_BYTES=10485760
EDAS_EVIDENCE_RETENTION_DAYS=365
EDAS_SIGNED_READ_TTL_SECONDS=60

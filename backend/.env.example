# Copy to backend/.env for local development. Never commit credentials.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
EDAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# For asymmetric signing, configure SUPABASE_URL and optionally comma-separated algorithms:
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# For projects using legacy HS256 signing only, set both values securely:
# SUPABASE_JWT_SECRET=<legacy-jwt-secret>
# SUPABASE_JWT_ALGORITHM=HS256
EDAS_EVIDENCE_BUCKET=road-evidence
EDAS_EVIDENCE_MAX_SIZE_BYTES=10485760
EDAS_EVIDENCE_RETENTION_DAYS=365
EDAS_SIGNED_READ_TTL_SECONDS=60
EDAS_VISION_STORAGE_BUCKET=vision-videos
EDAS_VISION_MAX_VIDEO_SIZE_BYTES=209715200
EDAS_VISION_MAX_DURATION_SECONDS=600
EDAS_VISION_SAMPLE_FPS=10
EDAS_VISION_IMAGE_SIZE=640
EDAS_VISION_CONFIDENCE=0.10
EDAS_VISION_WORKER_POLL_SECONDS=1
EDAS_VISION_MODEL_PATH=backend/vision/models/pothole/road_damage_best.pt
EDAS_VISION_VIDEO_RETENTION_DAYS=30
EDAS_VISION_EVENT_RETENTION_DAYS=365
EDAS_VISION_CLEANUP_INTERVAL_SECONDS=3600
EDAS_VISION_HEARTBEAT_INTERVAL_SECONDS=20
